# Required by webhook API and the Pine indicator input.
TV_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Use PostgreSQL in deployment. If omitted, local SQLite is used.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: enables screenshot MSS / OB / FVG review in Streamlit.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
